# Optional Docker Compose overrides. Defaults need no environment file.
# Copy this file to .env beside compose.yaml; never commit credentials.
PROD_PORT=3001
PROD_HOST=127.0.0.1
DEV_PORT=3000
MCP_INSPECTOR_PORT=6274
MCP_SANDBOX_PORT=6275

# Runtime server settings, forwarded to the app without rebuilding.
MCP_ENABLED=true
# Comma-separated exact browser origins; native clients need no Origin header.
MCP_ALLOWED_ORIGINS=

# To run several checkouts together, give each checkout a unique project name. Both modes of
# one checkout read this file, so run them together with --project-name (see docs/docker.md).
# COMPOSE_PROJECT_NAME=my-project
