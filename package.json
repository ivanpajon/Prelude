{
  "name": "next-template",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc --project tsconfig.tools.json",
    "check": "pnpm lint && pnpm typecheck",
    "lint": "biome check . && eslint . --max-warnings 0",
    "fix": "biome check --write . && eslint . --fix --max-warnings 0",
    "lint:staged": "lint-staged --concurrent false",
    "prepare": "husky",
    "test": "vitest run",
    "start": "pnpm --filter @repo/web start",
    "test:e2e": "pnpm build && playwright test",
    "test:cache": "node scripts/verify-build-cache.mjs",
    "verify": "pnpm check && pnpm test && pnpm test:e2e && pnpm test:cache"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@biomejs/biome": "2.5.14",
    "@shadcn/lint": "0.2.0",
    "@typescript-eslint/parser": "8.70.1",
    "eslint": "10.11.0",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "turbo": "2.11.4",
    "typescript": "6.0.3",
    "vitest": "5.0.2",
    "@playwright/test": "1.63.0"
  }
}
