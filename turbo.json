{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "env": ["NEXT_OUTPUT_STANDALONE"],
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "public/sw.js",
        "public/sw.js.map"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["PORT", "MCP_ENABLED", "MCP_ALLOWED_ORIGINS", "MCP_INSPECTOR_PORT"]
    },
    "typecheck": { "dependsOn": ["^typecheck"], "outputs": [] },
    "test": { "dependsOn": ["^build"], "outputs": [] },
    "test:stack": {
      "cache": false,
      "passThroughEnv": [
        "PRELUDE_STACK_URL",
        "PRELUDE_STACK_MODE",
        "PRELUDE_STACK_INSPECTOR_URL",
        "PRELUDE_STACK_CONTEXT",
        "PRELUDE_STACK_PROJECT",
        "PRELUDE_STACK_CONTAINER",
        "PRELUDE_STACK_NODE_BIN"
      ]
    }
  }
}
