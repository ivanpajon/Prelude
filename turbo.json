{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": ["scripts/build-mcp-apps.mjs", "tsconfig.base.json"],
  "globalPassThroughEnv": ["SWC_NATIVE_BINDING_CACHE"],
  "tasks": {
    "build": {
      "env": ["NEXT_OUTPUT_STANDALONE"],
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        ".generated/mcp-apps/**",
        "public/sw.js",
        "public/sw.js.map"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "PORT",
        "MCP_ENABLED",
        "MCP_ALLOWED_ORIGINS",
        "MCP_INSPECTOR_PORT",
        "MCP_SANDBOX_PORT"
      ]
    },
    "typecheck": { "dependsOn": ["^typecheck"], "outputs": [] }
  }
}
