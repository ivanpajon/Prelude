{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests", "docker:pinDigests"],
  "rangeStrategy": "pin",
  "timezone": "Etc/UTC",
  "schedule": ["before 6am on monday"],
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "schedule": ["at any time"]
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on the first day of the month"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "The Dockerfile installs the pnpm version from packageManager.",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": ["pnpm@(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "pnpm",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "Scalar's renderer loads from jsDelivr, so only its URL pins the version. The app and the tests import it from api-info.ts.",
      "managerFilePatterns": ["/^apps/web/src/lib/api-info\\.ts$/"],
      "matchStrings": ["@scalar/api-reference@(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "@scalar/api-reference",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "biome.json names its schema by the Biome version.",
      "managerFilePatterns": ["/^biome\\.json$/"],
      "matchStrings": ["biomejs\\.dev/schemas/(?<currentValue>\\d+\\.\\d+\\.\\d+)/schema\\.json"],
      "depNameTemplate": "@biomejs/biome",
      "datasourceTemplate": "npm"
    }
  ],
  "packageRules": [
    {
      "description": "Keep the Node range in engines; exact pins apply to dependencies.",
      "matchDepTypes": ["engines"],
      "rangeStrategy": "auto"
    },
    {
      "description": "Group non-major npm updates into one weekly pull request.",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "non-major npm dependencies"
    },
    {
      "description": "Packages that release together get their own groups; each group name sets its branch.",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["next", "react", "react-dom", "@types/react", "@types/react-dom"],
      "groupName": "Next.js and React"
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["@orpc/**"],
      "groupName": "oRPC"
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["@modelcontextprotocol/**"],
      "groupName": "MCP SDK"
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["serwist", "@serwist/**"],
      "groupName": "Serwist"
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["vitest", "@vitest/**"],
      "groupName": "Vitest"
    },
    {
      "description": "Biome patch releases can change nursery rules, so a lint failure must not hold back other updates.",
      "matchPackageNames": ["@biomejs/biome"],
      "groupName": "Biome"
    },
    {
      "description": "TypeScript stays on 6.0.x; see docs/requirements.md (Version policy).",
      "matchPackageNames": ["typescript"],
      "matchUpdateTypes": ["minor", "major"],
      "enabled": false
    },
    {
      "description": "Node stays within 26.x in .node-version, @types/node, engines, and the Dockerfile image.",
      "matchPackageNames": ["node", "@types/node"],
      "allowedVersions": "/^26\\./"
    },
    {
      "description": "Update the Node runtime together: @types/node and both images. .node-version follows once the line is LTS, and the engines range stays; see docs/requirements.md.",
      "matchPackageNames": ["node", "@types/node", "gcr.io/distroless/nodejs26-debian13"],
      "groupName": "Node.js"
    },
    {
      "description": "pnpm follows packageManager; update it with engines.pnpm and the Dockerfile.",
      "matchPackageNames": ["pnpm"],
      "groupName": "pnpm"
    }
  ]
}
