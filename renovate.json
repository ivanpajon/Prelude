{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests", "docker:pinDigests"],
  "rangeStrategy": "pin",
  "timezone": "Etc/UTC",
  "schedule": ["before 6am on monday"],
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "schedule": ["at any time"]
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on the first day of the month"]
  },
  "packageRules": [
    {
      "description": "Keep the Node range in engines; exact pins apply to dependencies.",
      "matchDepTypes": ["engines"],
      "rangeStrategy": "auto"
    },
    {
      "description": "Group non-major npm updates into one weekly pull request.",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "non-major npm dependencies",
      "groupSlug": "npm-non-major"
    },
    {
      "description": "Keep packages that release together in their own non-major groups.",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["next", "react", "react-dom", "@types/react", "@types/react-dom"],
      "groupName": "Next.js and React"
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["@orpc/**"],
      "groupName": "oRPC"
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["@modelcontextprotocol/**"],
      "groupName": "MCP SDK"
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["serwist", "@serwist/**"],
      "groupName": "Serwist"
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["vitest", "@vitest/**"],
      "groupName": "Vitest"
    },
    {
      "description": "TypeScript stays on 6.0.x; see docs/requirements.md (Version policy).",
      "matchPackageNames": ["typescript"],
      "matchUpdateTypes": ["minor", "major"],
      "enabled": false
    },
    {
      "description": "Node stays within 26.x in .node-version, @types/node, engines, and the Dockerfile image.",
      "matchPackageNames": ["node", "@types/node"],
      "allowedVersions": "/^26\\./"
    },
    {
      "description": "pnpm follows packageManager; update it together with engines.pnpm.",
      "matchPackageNames": ["pnpm"],
      "groupName": "pnpm"
    }
  ]
}
