{
  "$schema": "https://react.doctor/schema/config.json",
  "ignore": {
    "overrides": [
      {
        "files": ["package.json"],
        "rules": ["react-doctor/require-reduced-motion"]
      },
      {
        "files": ["src/app/**/offline/offline-content.tsx"],
        "rules": ["react-doctor/nextjs-no-a-element"]
      },
      {
        "files": ["src/app/actions/locale.ts"],
        "rules": ["react-doctor/server-auth-actions"]
      },
      {
        "files": ["src/components/pwa-provider.tsx"],
        "rules": ["react-doctor/no-loading-flag-reset-outside-finally"]
      }
    ]
  }
}
