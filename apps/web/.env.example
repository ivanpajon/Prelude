# Optional overrides. Copy to apps/web/.env.local; no configuration is required.
# MCP is public by default in development and production. Set false to return 404.
# MCP_ENABLED=false

# Production accepts native clients without Origin. Browser Origins require an
# exact allowlist (this does not enable CORS or provide authentication).
# MCP_ALLOWED_ORIGINS=https://prelude.example

# The local-only Inspector starts with pnpm dev; select another UI port if needed.
# MCP_INSPECTOR_PORT=6274
